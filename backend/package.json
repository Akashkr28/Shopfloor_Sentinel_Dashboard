{
  "name": "shopfloor-sentinel-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shopfloor Sentinel \u2013 Node.js API, alert logic and owner notifications",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch src/server.js",
    "seed": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/seed.js --reset",
    "test": "node --disable-warning=ExperimentalWarning --test 'test/*.test.js'",
    "kb:index": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/kb.js index",
    "kb:search": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/kb.js search",
    "kb:fetch-cisa": "node scripts/fetch-cisa-advisories.js",
    "mcp": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/mcp/server.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.2",
    "chromadb": "^3.5.0"
  }
}

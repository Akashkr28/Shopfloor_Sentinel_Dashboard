# Copy to backend/.env – it is loaded automatically. Never commit the real file.

# ---------- Core ----------
NODE_ENV=production                 # refuses to start with the development secrets below
PORT=4000
# 32+ random characters each:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
GATEWAY_TOKEN=                      # same value in gateway/config.json → gatewayToken
JWT_EXPIRES_IN=12h
COOKIE_SECURE=true                  # session cookie only over HTTPS (set false only for plain-HTTP LAN tests)
TRUST_PROXY=loopback                # behind Caddy / nginx on the same box
PUBLIC_URL=                         # https://sentinel.yourfactory.in – needed for delivery-status webhooks
SEED_DEMO=false                     # true = demo users (password sentinel123) and machines

# First boot only (no users yet): creates the first owner account.
INITIAL_OWNER_USERNAME=owner
INITIAL_OWNER_PASSWORD=
INITIAL_OWNER_NAME=Factory Owner
INITIAL_OWNER_PHONE=+91XXXXXXXXXX

# ---------- Alerting rules ----------
RED_DEDUP_MINUTES=30                # same red alert on the same machine pings the owner at most once per window
ESCALATE_UNACK_MINUTES=10           # red alert nobody acknowledged → owners + engineers
ESCALATE_UNRESOLVED_MINUTES=60      # red alert still unresolved → owners again
NOTIFY_RESOLVED=true                # "✅ handled" follow-up to owners
GATEWAY_OFFLINE_MINUTES=10          # no heartbeat → owners + engineers
DAILY_SUMMARY_CRON="0 20 * * *"
TZ_NAME=Asia/Kolkata

# ---------- Owner messaging: mock | twilio | whatsapp_cloud ----------
NOTIFY_PROVIDER=mock
NOTIFY_CHANNEL=WHATSAPP             # or SMS (Twilio only)
NOTIFY_MAX_ATTEMPTS=4               # retries with backoff 30s, 2m, 10m
SMS_FALLBACK=true                   # Twilio: re-send as SMS if WhatsApp keeps failing

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+14155238886            # WhatsApp sender (sandbox or approved number)
TWILIO_SMS_FROM=                    # SMS-capable number, if different
# Approved WhatsApp content templates (HX…); without them only free text inside the 24h window works.
TWILIO_CONTENT_SID_RED_ALERT=
TWILIO_CONTENT_SID_DAILY_SUMMARY=
TWILIO_CONTENT_SID_ESCALATION=
TWILIO_CONTENT_SID_RESOLVED_UPDATE=
TWILIO_CONTENT_SID_GATEWAY_OFFLINE=

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=                # verifies webhook signatures
WHATSAPP_VERIFY_TOKEN=              # any string; enter the same in the Meta webhook setup
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_TEMPLATE_RED_ALERT=        # approved template names – see docs/DEPLOYMENT.md
WHATSAPP_TEMPLATE_DAILY_SUMMARY=
WHATSAPP_TEMPLATE_ESCALATION=
WHATSAPP_TEMPLATE_RESOLVED_UPDATE=
WHATSAPP_TEMPLATE_GATEWAY_OFFLINE=

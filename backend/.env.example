# Copy to your shell / systemd unit / pm2 config. All values are optional for the demo.
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
GATEWAY_TOKEN=change-me-and-put-the-same-value-in-gateway/config.json

# Owner notifications: mock (console only) | twilio | whatsapp_cloud
NOTIFY_PROVIDER=mock
NOTIFY_CHANNEL=WHATSAPP            # or SMS (twilio only)

# Twilio (WhatsApp sandbox or SMS number)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+14155238886

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Only the first red alert of the same type on the same machine within this window pings the owner
RED_DEDUP_MINUTES=30
DAILY_SUMMARY_CRON="0 20 * * *"
TZ_NAME=Asia/Kolkata
